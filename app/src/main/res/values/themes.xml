<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose renders all UI; the View-system theme only styles the
         window background / splash before first composition. -->
    <style name="Theme.SlmChat" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/ic_launcher_background</item>
        <item name="android:statusBarColor">@color/slm_green</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
